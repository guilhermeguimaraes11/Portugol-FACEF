programa
{
	funcao inicio()
	{
		inteiro num, fat = 1 

		escreva("Digite um numero para fatorar: ")
		leia(num)

		faca
		{
			escreva("Número:" , num)
			fat = fat * num
			num--
		}
		enquanto(num > 1)

		escreva("\nFatorial: ", fat)
	}
}
