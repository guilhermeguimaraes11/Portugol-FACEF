programa
{
	funcao inicio()
	{
		inteiro num, resultado
		inteiro cont = 0

		escreva("Digite um numero para ver a tabuada: ")
		leia(num)

		

		faca
		{
			resultado = num * cont

			escreva(num, "x", cont, "=" , resultado, "\n")
			cont++
			

		} enquanto (cont <= 10)
		
	}
}
